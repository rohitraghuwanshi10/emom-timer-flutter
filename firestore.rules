rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Household account UIDs (Firebase console > Authentication > Users). Not secrets.
    function isHousehold() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.uid in ['REPLACE_WITH_HOUSEHOLD_UID'];
    }
    match /profiles/{id}  { allow read, write: if isHousehold(); }
    match /templates/{id} { allow read, write: if isHousehold(); }
    match /workouts/{id}  { allow read, write: if isHousehold(); }
    // Everything else is denied by default.
  }
}
